    <string name="about_title">About SDS011 Native</string>
    <string name="about_tab_info">General</string>
    <string name="about_tab_hardware">Hardware &amp; Setup</string>
    <string name="about_tab_license">Licenses</string>

    <string name="about_app_desc">Native Android app for mobile particulate matter measurement using the SDS011 laser dust sensor over Bluetooth Classic (HC-05/HC-06).</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_text">The displayed measurement values are for informational purposes only. The developer assumes no liability for the accuracy of the data or damages caused by malfunctions.</string>

    <string name="hardware_wiring_title">Sensor &amp; Bluetooth Wiring</string>
    <string name="hardware_wiring_text">The SDS011 particulate matter sensor is connected to the Android smartphone via a serial Bluetooth module (HC-05 or HC-06):\n\n• SDS011 TX ➔ HC-06 RX\n• SDS011 RX ➔ HC-06 TX\n• SDS011 5V ➔ 5V Power Supply (Powerbank / USB)\n• SDS011 GND ➔ GND\n\nBefore connecting for the first time, pair the HC-05/HC-06 module once in Android Bluetooth settings (pairing PIN is usually 1234 or 0000).</string>

